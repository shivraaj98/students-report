# Run npm run automation:setup to generate these values in .env.
# Preserve .env with the Docker data volumes. Replacing the master key prevents
# decrypting a previously saved vision account key. Never commit .env.
CLASSBRIDGE_INTERNAL_TOKEN=
CLASSBRIDGE_SETUP_TOKEN=
CLASSBRIDGE_MASTER_KEY=

# Set automatically by npm run automation:share. An optional permanent HTTPS
# reverse proxy must set this to its exact origin, with no trailing slash.
CLASSBRIDGE_PUBLIC_ORIGIN=
